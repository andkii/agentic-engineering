{
  "description": "eng-laws guards: mechanical enforcement of rules in ENGINEERING_LAWS.md",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
